{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lvlaksim1/ai-agent-lab/.agent/schemas/event.schema.json",
  "title": "Agent Queue Event",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "id", "created_at", "type", "priority", "status", "source", "target", "goal"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "type": { "type": "string", "minLength": 1 },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "status": { "const": "pending" },
    "source": { "type": "object" },
    "target": {
      "type": "object",
      "required": ["repository", "ref"],
      "properties": {
        "repository": { "type": "string", "minLength": 3 },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "goal": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
