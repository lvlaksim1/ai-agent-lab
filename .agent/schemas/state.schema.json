{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Runtime State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "active_event", "worker_id", "started_at", "lease_until", "last_event", "last_result", "last_completed_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["idle", "processing"] },
    "active_event": { "type": ["string", "null"] },
    "worker_id": { "type": ["string", "null"] },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "lease_until": { "type": ["string", "null"], "format": "date-time" },
    "last_event": { "type": ["string", "null"] },
    "last_result": { "type": ["string", "null"] },
    "last_completed_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
